# ══════════════════════════════════════════════════════════
#  .env.local — configuración de DESARROLLO LOCAL
#  Copia este fichero a .env.local y rellena los valores.
#  .env.local está en .gitignore: NUNCA se sube al repo.
#
#  Para LOCAL no necesitas los secretos de nadie: genera los
#  tuyos propios (abajo) y apunta a TU PostgreSQL local.
# ══════════════════════════════════════════════════════════

# ── PostgreSQL local ──────────────────────────────────────
# Apunta a TU Postgres local (localhost), a la base de datos "salamandra"
# con el usuario/contraseña que hayas creado tú (ver CONTRIBUTING.md §1.2).
# OJO: en local es "localhost", NO "db" (eso es solo la red Docker de producción).
DATABASE_URL=postgresql://crm_user:TU_PASSWORD_LOCAL@localhost:5432/salamandra

# ── JWT (firma de sesiones) ───────────────────────────────
# Para LOCAL vale cualquier valor aleatorio; NO tiene que coincidir con el de
# producción ni con el de otros desarrolladores. Genéralo con:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=PEGA_AQUI_UN_SECRET_ALEATORIO_DE_64_BYTES
# JWT_REFRESH_SECRET es OPCIONAL: si lo dejas fuera, se deriva de JWT_SECRET.

# ── Cifrado en reposo de secretos por-tenant (Configuración → IA) ─────────
# Cifra (AES-256-GCM) las API keys que cada tenant pega en la app. Para local
# vale cualquier valor aleatorio de 32 bytes:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SETTINGS_ENCRYPTION_KEY=PEGA_AQUI_OTRO_SECRET_ALEATORIO_DE_32_BYTES

# ── IA en local (opcional pero recomendado) ───────────────
# Analizador de Captación (Outreach) SIMULADO: no llama a Claude ni gasta tokens.
# Útil para desarrollar sin claves de IA. Se IGNORA en producción a propósito.
OUTREACH_FAKE_AI=1

# ── Resto de integraciones (opcionales en local) ──────────
# Déjalas vacías/fuera salvo que vayas a probar esa integración concreta.
# Las claves de IA REALES (Claude / Whisper) son POR TENANT: se pegan dentro de
# la app en Configuración → IA, NO aquí.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
# N8N_WEBHOOK_URL=
# FACTURANTIA_API_KEY=
# FACTURANTIA_API_URL=https://api.facturantia.com
