# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...pero SÍ versionamos las plantillas de ejemplo (sin secretos reales)
!.env*.example

# vercel
.vercel

# uploads (archivos subidos por usuarios — volumen Docker en prod, dir local en dev)
/uploads

# typescript
*.tsbuildinfo
next-env.d.ts

!.env.production.example
qa-credentials.txt
.claude/settings.local.json

# Git Bash crash dumps en Windows
bash.exe.stackdump

# Ficheros de pruebas manuales con credenciales/tokens (QA local).
# NUNCA deben volver al repo: contienen contraseñas y cookies de sesión.
cookie.txt
cookies.txt
login.json
fiscal.json
*.cookies.txt

# Respaldos de borrado de pacientes (scripts/borrar-rastro-paciente.js).
# Llevan datos personales y de salud copiados tal cual de la base de datos:
# fuera del repositorio, siempre.
rastro-*.json
