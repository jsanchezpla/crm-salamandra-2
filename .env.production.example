# ══════════════════════════════════════════════════════════
#  .env.production  —  copiar este fichero, rellenar valores
#  NUNCA subir al repositorio (ya está en .gitignore)
# ══════════════════════════════════════════════════════════

# ── PostgreSQL (usado por el contenedor db Y por la app) ──
# Los tres POSTGRES_* los lee el contenedor de postgres directamente
POSTGRES_DB=salamandra
POSTGRES_USER=crm_user
POSTGRES_PASSWORD=CAMBIA_ESTA_PASSWORD

# La app conecta a través de la red Docker ("db" = nombre del servicio)
DATABASE_URL=postgresql://crm_user:CAMBIA_ESTA_PASSWORD@db:5432/salamandra

# ── Entorno ───────────────────────────────────────────────
NODE_ENV=production

# ── JWT ───────────────────────────────────────────────────
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=GENERA_UN_SECRET_DE_64_BYTES_AQUI
JWT_EXPIRES_IN=7d

# ── Cifrado en reposo de secretos por-tenant ──────────────────────────────
# Cifra (AES-256-GCM) las API keys de IA que cada tenant guarda en
# Configuración → IA (settings.integrations). SIN esta variable, esas claves se
# guardan EN CLARO en la BD; con ella, un dump/backup solo contiene texto cifrado.
# Genera un valor aleatorio fuerte con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ⚠️ CRÍTICO: si la cambias o la pierdes, las claves ya cifradas dejan de poder
#    leerse (los tenants tendrían que volver a pegarlas). Trátala como el JWT_SECRET.
SETTINGS_ENCRYPTION_KEY=

# ── OpenAI ────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Facturantia (Verifactu) ──────────────────────────────
FACTURANTIA_API_KEY=
FACTURANTIA_API_URL=https://api.facturantia.com

# ── n8n webhooks ──────────────────────────────────────────
N8N_WEBHOOK_URL=https://tu-n8n.dominio.com/webhook

# ── TutorLMS (webhooks de formación: Retorika, NutriLaura…) ──
# UN SECRETO POR TENANT (JSON {slug: secret}). Cada WordPress conectado firma sus
# webhooks con SU propio secreto; en su wp-config.php va como
#   define('CRM_WEBHOOK_SECRET', '<el secreto DE ESE tenant>');
# (el nombre del define es siempre el mismo; lo que cambia es el valor).
#
# POR QUÉ POR TENANT: el tenant destino viaja en la cabecera `x-tenant`, que la
# pone quien llama. Con un único secreto compartido, cualquiera que lo tuviera
# podía escribir en CUALQUIER tenant con training activo (p. ej. el WP de una
# clienta inyectando matrículas en el de otra). Con secreto por tenant la firma
# demuestra "tengo la llave del tenant que digo ser".
#
# Generar uno POR CADA WordPress:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRM_WEBHOOK_SECRETS={"retorika":"SECRETO_DE_RETORIKA","nutri_laura":"SECRETO_DE_NUTRI_LAURA"}
#
# FALLBACK de transición: se usa solo para los tenants que TODAVÍA no tienen
# entrada propia arriba (las entradas por-tenant tienen precedencia). Cuando
# todos los WordPress tengan el suyo, deja esto vacío y bórralo.
# (Nombre viejo RETORIKA_WEBHOOK_SECRET: aún aceptado como fallback, en desuso.)
CRM_WEBHOOK_SECRET=

# Endpoints externos /api/external/retorika/* (paneles propios)
RETORIKA_API_KEY=

# URL del endpoint público en WordPress de Retorika que dispara la
# sincronización completa de cursos (sprint F3). Sin esta variable, la UI
# del CRM no muestra el banner de "sincronizar cursos" para el tenant.
# Convención de naming: {TENANT_SLUG_UPPER}_TUTOR_SYNC_URL.
RETORIKA_TUTOR_SYNC_URL=https://asesoriaretorika.com/?retorika_sync_courses=1

# URL en WordPress que dispara la sincronización de cuestionarios (quizzes)
# desde TutorLMS. Mismo patrón que la URL de cursos: el admin debe estar
# logueado en WP al visitarla. Sin esta variable, /formacion/cuestionarios
# no muestra el banner informativo.
# Convención de naming: {TENANT_SLUG_UPPER}_TUTOR_QUIZZES_SYNC_URL.
RETORIKA_TUTOR_QUIZZES_SYNC_URL=https://asesoriaretorika.com/?retorika_sync_quizzes=1

# Pull de cuestionarios desde TutorLMS (Basic Auth WP REST API)
WP_URL=https://tu-wordpress.dominio.com
WP_API_USER=
WP_API_KEY=

# ── Resend — emails transaccionales ───────────────────────────────────────
# Sprint Fase 1 nutri_laura. Si RESEND_API_KEY está vacío o = "dry-run",
# el helper hace dry-run (loguea sin enviar). En producción:
#   1. Crear cuenta en resend.com (plan gratis 3000/mes).
#   2. Verificar el dominio que usarás como remitente (SPF + DKIM).
#   3. Generar API key y pegarla aquí.
# Detalle: docs/modules/emails.md
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ── Back-office interno (admin.salamandrasolutions.com) ───────────────────
# El host desde el que se sirve /admin. FALLA EN CERRADO: sin esta variable el
# panel NO se sirve en ningún sitio, y con ella el CRM de los clientes deja de
# servirlo (404). En local: admin.localhost:3000
# Detalle: docs/base/deploy.md y middleware.js
ADMIN_HOST=admin.salamandrasolutions.com

# A dónde llegan los avisos que los clientes nos escriben desde su Ayuda
# (/ayuda → /admin/buzon). Si se deja vacío, info@salamandrasolutions.com.
# OJO: el correo NO sale con RESEND_API_KEY de aquí abajo, sino con las
# credenciales de Resend del tenant `salamandra_solutions` (Configuración →
# Resend). Detalle: docs/modules/buzon.md
SOPORTE_EMAIL=

# ── Resend — CORREO ENTRANTE del módulo Soporte (opcional) ────────────────
# Con esto, las respuestas por email de los clientes caen solas en el hilo de
# su ticket, y el buzón propio del tenant (soporte@suempresa.com) puede
# reenviar aquí su correo para que TODO quede en el CRM. Setup en Resend:
#   1. Añadir un dominio de RECEPCIÓN (p.ej. inbound.salamandrasolutions.com)
#      con su registro MX según indica Resend.
#   2. Crear un webhook para el evento de email recibido apuntando a
#      https://crm.salamandrasolutions.com/api/webhooks/resend-inbound
#   3. Pegar el signing secret (whsec_...) del webhook aquí.
# Cada tenant recibe en soporte-{slug}@{RESEND_INBOUND_DOMAIN}. Sin estas dos
# vars no hay captura: los clientes responden por su enlace del portal.
# Detalle: docs/modules/support.md
RESEND_INBOUND_DOMAIN=
RESEND_WEBHOOK_SECRET=

# ── Portal "Mis citas" — SSO WordPress ────────────────────────────────────
# Portal público donde el cliente ve/cancela sus citas (segundo iframe en WP).
# Dos secretos independientes (generar cada uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"):
#
#   WIDGET_SSO_SECRETS — JSON { slug: secret }. Secreto COMPARTIDO con el
#   WordPress del tenant para firmar/verificar el token `wpsso`. El MISMO valor
#   debe ir en wp-config.php (CRM_WIDGET_SSO_SECRET). Ver
#   docs/modules/citas-portal-wordpress-snippet.php.
#
#   ROTAR SIN CORTE: el valor puede ser una LISTA en vez de un string, y
#   entonces valen todos para verificar y se FIRMA con el primero:
#     WIDGET_SSO_SECRETS={"nutri_laura":["<nuevo>","<viejo>"]}
#   Se pone el nuevo delante y se despliega (nada se rompe, el viejo sigue
#   valiendo), se cambia wp-config.php con calma, y en el siguiente despliegue
#   se quita el viejo. Con un solo secreto había que cambiar las dos puntas al
#   mismo segundo, y eso ya costó un corte en el portal de Laura.
#
#   CITAS_PORTAL_SESSION_SECRET — secreto PROPIO del CRM para el sessionToken
#   del portal (~60 min). Distinto de JWT_SECRET y de WIDGET_SSO_SECRETS.
#
# Además, activar el flag por tenant con:
#   docker compose exec app node scripts/configure-nutri-laura-citas-portal.js
WIDGET_SSO_SECRETS={"nutri_laura":"GENERA_UN_SECRET_DE_32_BYTES_AQUI"}
CITAS_PORTAL_SESSION_SECRET=GENERA_OTRO_SECRET_DE_32_BYTES_AQUI

# ── Puesta al día de usuarios de la web → fichas de cliente ───────────────
# Enlace de WordPress que manda al CRM TODOS sus usuarios para que los que no
# tengan ficha aparezcan como solicitudes en Formularios (cierra el círculo con
# las cuentas creadas ANTES de montar el aviso automático `user_register`).
#
# Sin esta variable, la pantalla de Clientes NO enseña el botón "Sincronizar
# web" para ese tenant — igual que el banner de Formación con su URL de sync.
# El CRM no llama a WordPress: el enlace lo abre el admin en SU navegador, ya
# logueado en su web (por eso no hace falta guardar credenciales de WP aquí).
# Convención de naming: {TENANT_SLUG_UPPER}_WP_USERS_SYNC_URL.
NUTRI_LAURA_WP_USERS_SYNC_URL=https://tunutrilaura.com/?nutrilaura_sync_usuarios=1

# ── Widget embebible: quién puede incrustarlo ─────────────────────────────
# JSON { slug: "https://dominio https://www.dominio" } con los dominios que
# pueden meter el widget de citas de cada cliente en un iframe.
#
# POR QUÉ: sin esto cualquiera puede incrustar la reserva de citas de un cliente
# en su propia web y hacerse pasar por él ante sus pacientes. Un tenant SIN
# entrada aquí queda abierto (comportamiento histórico), así que se va cerrando
# cliente a cliente conforme confirman su dominio.
WIDGET_FRAME_ANCESTORS={"nutri_laura":"https://tunutrilaura.com https://www.tunutrilaura.com"}

# ── Uploads (volumen Docker) ──────────────────────────────────────────────
# UPLOADS_HOST_DIR es una variable SOLO de docker-compose: el path del HOST que
# se monta (bind mount) en /app/uploads dentro del contenedor. Guarda archivos
# subidos por usuarios (adjuntos de clientes + módulo Documents).
#   - Producción usa: UPLOADS_HOST_DIR=/opt/crm-salamandra/uploads
#   - Si está vacío, docker-compose cae a ./uploads (dentro del checkout: frágil).
#
# NO CONFUNDIR con UPLOADS_ROOT: esa es una variable del CÓDIGO
# (lib/*/…Storage.js) que apunta al path DENTRO del contenedor. En producción el
# código resuelve siempre "/app/uploads" y NO lee UPLOADS_ROOT (solo se usa como
# override en tests). Es decir: UPLOADS_HOST_DIR (host) → bind → /app/uploads
# (contenedor) ← lo que ve el código. No hace falta setear UPLOADS_ROOT en prod.
UPLOADS_HOST_DIR=/opt/crm-salamandra/uploads

# ── Google Calendar / Meet — Fase 2 (no usado todavía) ────────────────────
# Placeholder para la integración real con Google Calendar API en el
# próximo sprint. Hoy los Meet links en bookings son snapshots de
# EventType.meetUrl (URLs estáticas configuradas manualmente).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_TOKEN_ENCRYPTION_KEY=

# ── Módulo Outreach (Captación) ───────────────────────────────────────────
# Análisis de leads con IA. Solo se usa la API de Claude.
#   ANTHROPIC_API_KEY — YA NO SE USA. La clave de Anthropic es POR TENANT (BYOK):
#   cada cliente la pega en Configuración → IA (settings.integrations). El código
#   NO lee esta env var; se deja aquí solo por historia. Un tenant sin su clave
#   recibe 503 al analizar.
ANTHROPIC_API_KEY=

# Scraping vía n8n ("Buscar nuevos"). El CRM llama a este webhook y n8n
# devuelve las empresas en la misma respuesta.
#   OUTREACH_SCRAPING_WEBHOOK_URL — URL COMPLETA del webhook de scraping.
#   OJO: no reutilizar N8N_WEBHOOK_URL, que en este CRM es la base genérica.
#   OUTREACH_WEBHOOK_SECRET — secreto para firmar el cuerpo con HMAC-SHA256.
#   El flujo de n8n debe verificar la cabecera `x-outreach-signature`.
#   Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OUTREACH_SCRAPING_WEBHOOK_URL=
OUTREACH_WEBHOOK_SECRET=

# Remitente/reply-to POR DEFECTO del correo de captación. Cada tenant puede
# sobrescribirlos en Configuración → IA (Remitente del correo). Si el tenant no
# los pone, se usan estos. El dominio debe estar verificado en la cuenta de
# Resend que corresponda.
OUTREACH_FROM_EMAIL=
OUTREACH_REPLY_TO=

# OUTREACH_RESEND_API_KEY — YA NO SE USA. La clave de Resend del correo de
# captación es POR TENANT (BYOK): cada cliente la pega en Configuración → IA,
# cifrada en reposo (SETTINGS_ENCRYPTION_KEY). El código no lee esta env var.
OUTREACH_RESEND_API_KEY=

# OUTREACH_FAKE_AI=1 activa un analizador SIMULADO (sin llamar a Claude) para
# desarrollo local. Está deliberadamente IGNORADO cuando NODE_ENV=production:
# nunca debe poder desactivarse la IA real en el VPS con una env var.

# ── Transcripción de audio (sesiones clínicas) — API de Whisper de OpenAI ──────
# El paso voz→texto usa la API de Whisper de OpenAI. La clave es POR TENANT (BYOK):
# cada cliente la pega en Configuración → IA (settings.integrations.openaiApiKey),
# cifrada en reposo. El CRM NO lee ninguna OPENAI_API_KEY del entorno. Después, Claude
# (Anthropic, también por-tenant) hace el resumen/estructura de la sesión.
