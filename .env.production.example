# ══════════════════════════════════════════════════════════
#  .env.production  —  copiar este fichero, rellenar valores
#  NUNCA subir al repositorio (ya está en .gitignore)
# ══════════════════════════════════════════════════════════

# ── PostgreSQL (usado por el contenedor db Y por la app) ──
# Los tres POSTGRES_* los lee el contenedor de postgres directamente
POSTGRES_DB=salamandra
POSTGRES_USER=crm_user
POSTGRES_PASSWORD=CAMBIA_ESTA_PASSWORD

# La app conecta a través de la red Docker ("db" = nombre del servicio)
DATABASE_URL=postgresql://crm_user:CAMBIA_ESTA_PASSWORD@db:5432/salamandra

# ── Entorno ───────────────────────────────────────────────
NODE_ENV=production

# ── JWT ───────────────────────────────────────────────────
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=GENERA_UN_SECRET_DE_64_BYTES_AQUI
JWT_EXPIRES_IN=7d

# ── Cifrado en reposo de secretos por-tenant ──────────────────────────────
# Cifra (AES-256-GCM) las API keys de IA que cada tenant guarda en
# Configuración → IA (settings.integrations). SIN esta variable, esas claves se
# guardan EN CLARO en la BD; con ella, un dump/backup solo contiene texto cifrado.
# Genera un valor aleatorio fuerte con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ⚠️ CRÍTICO: si la cambias o la pierdes, las claves ya cifradas dejan de poder
#    leerse (los tenants tendrían que volver a pegarlas). Trátala como el JWT_SECRET.
SETTINGS_ENCRYPTION_KEY=

# ── OpenAI ────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Facturantia (Verifactu) ──────────────────────────────
FACTURANTIA_API_KEY=
FACTURANTIA_API_URL=https://api.facturantia.com

# ── n8n webhooks ──────────────────────────────────────────
N8N_WEBHOOK_URL=https://tu-n8n.dominio.com/webhook

# ── TutorLMS / Retorika ───────────────────────────────────
# Secret HMAC compartido entre el plugin de WordPress de Retorika y el CRM
# para firmar los webhooks entrantes en /api/webhooks/tutorlms/*.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CRÍTICO: el plugin de WP debe usar EXACTAMENTE el mismo valor.
RETORIKA_WEBHOOK_SECRET=baa441846d00b635e72bc8f7a4ae04bae702ed9c37a3105f29f82350be2f16c1

# Endpoints externos /api/external/retorika/* (paneles propios)
RETORIKA_API_KEY=

# URL del endpoint público en WordPress de Retorika que dispara la
# sincronización completa de cursos (sprint F3). Sin esta variable, la UI
# del CRM no muestra el banner de "sincronizar cursos" para el tenant.
# Convención de naming: {TENANT_SLUG_UPPER}_TUTOR_SYNC_URL.
RETORIKA_TUTOR_SYNC_URL=https://asesoriaretorika.com/?retorika_sync_courses=1

# URL en WordPress que dispara la sincronización de cuestionarios (quizzes)
# desde TutorLMS. Mismo patrón que la URL de cursos: el admin debe estar
# logueado en WP al visitarla. Sin esta variable, /formacion/cuestionarios
# no muestra el banner informativo.
# Convención de naming: {TENANT_SLUG_UPPER}_TUTOR_QUIZZES_SYNC_URL.
RETORIKA_TUTOR_QUIZZES_SYNC_URL=https://asesoriaretorika.com/?retorika_sync_quizzes=1

# Pull de cuestionarios desde TutorLMS (Basic Auth WP REST API)
WP_URL=https://tu-wordpress.dominio.com
WP_API_USER=
WP_API_KEY=

# ── Resend — emails transaccionales ───────────────────────────────────────
# Sprint Fase 1 nutri_laura. Si RESEND_API_KEY está vacío o = "dry-run",
# el helper hace dry-run (loguea sin enviar). En producción:
#   1. Crear cuenta en resend.com (plan gratis 3000/mes).
#   2. Verificar el dominio que usarás como remitente (SPF + DKIM).
#   3. Generar API key y pegarla aquí.
# Detalle: docs/modules/emails.md
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ── Portal "Mis citas" — SSO WordPress ────────────────────────────────────
# Portal público donde el cliente ve/cancela sus citas (segundo iframe en WP).
# Dos secretos independientes (generar cada uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"):
#
#   WIDGET_SSO_SECRETS — JSON { slug: secret }. Secreto COMPARTIDO con el
#   WordPress del tenant para firmar/verificar el token `wpsso`. El MISMO valor
#   debe ir en wp-config.php (CRM_WIDGET_SSO_SECRET). Ver
#   docs/modules/citas-portal-wordpress-snippet.php.
#
#   CITAS_PORTAL_SESSION_SECRET — secreto PROPIO del CRM para el sessionToken
#   del portal (~60 min). Distinto de JWT_SECRET y de WIDGET_SSO_SECRETS.
#
# Además, activar el flag por tenant con:
#   docker compose exec app node scripts/configure-nutri-laura-citas-portal.js
WIDGET_SSO_SECRETS={"nutri_laura":"GENERA_UN_SECRET_DE_32_BYTES_AQUI"}
CITAS_PORTAL_SESSION_SECRET=GENERA_OTRO_SECRET_DE_32_BYTES_AQUI

# ── Uploads (volumen Docker) ──────────────────────────────────────────────
# Path host del volumen montado en /app/uploads (archivos PDF de clientes,
# etc.). Si está vacío, docker-compose usa ./uploads relativo al compose.
# Para producción se recomienda un path absoluto fuera del repo:
#   UPLOADS_HOST_DIR=/var/lib/crm/uploads
UPLOADS_HOST_DIR=

# ── Google Calendar / Meet — Fase 2 (no usado todavía) ────────────────────
# Placeholder para la integración real con Google Calendar API en el
# próximo sprint. Hoy los Meet links en bookings son snapshots de
# EventType.meetUrl (URLs estáticas configuradas manualmente).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_TOKEN_ENCRYPTION_KEY=

# ── Módulo Outreach (Captación) ───────────────────────────────────────────
# Análisis de leads con IA. Solo se usa la API de Claude.
#   ANTHROPIC_API_KEY — YA NO SE USA. La clave de Anthropic es POR TENANT (BYOK):
#   cada cliente la pega en Configuración → IA (settings.integrations). El código
#   NO lee esta env var; se deja aquí solo por historia. Un tenant sin su clave
#   recibe 503 al analizar.
ANTHROPIC_API_KEY=

# Scraping vía n8n ("Buscar nuevos"). El CRM llama a este webhook y n8n
# devuelve las empresas en la misma respuesta.
#   OUTREACH_SCRAPING_WEBHOOK_URL — URL COMPLETA del webhook de scraping.
#   OJO: no reutilizar N8N_WEBHOOK_URL, que en este CRM es la base genérica.
#   OUTREACH_WEBHOOK_SECRET — secreto para firmar el cuerpo con HMAC-SHA256.
#   El flujo de n8n debe verificar la cabecera `x-outreach-signature`.
#   Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OUTREACH_SCRAPING_WEBHOOK_URL=
OUTREACH_WEBHOOK_SECRET=

# Remitente/reply-to POR DEFECTO del correo de captación. Cada tenant puede
# sobrescribirlos en Configuración → IA (Remitente del correo). Si el tenant no
# los pone, se usan estos. El dominio debe estar verificado en la cuenta de
# Resend que corresponda.
OUTREACH_FROM_EMAIL=
OUTREACH_REPLY_TO=

# OUTREACH_RESEND_API_KEY — YA NO SE USA. La clave de Resend del correo de
# captación es POR TENANT (BYOK): cada cliente la pega en Configuración → IA,
# cifrada en reposo (SETTINGS_ENCRYPTION_KEY). El código no lee esta env var.
OUTREACH_RESEND_API_KEY=

# OUTREACH_FAKE_AI=1 activa un analizador SIMULADO (sin llamar a Claude) para
# desarrollo local. Está deliberadamente IGNORADO cuando NODE_ENV=production:
# nunca debe poder desactivarse la IA real en el VPS con una env var.

# ── Transcripción de audio (sesiones clínicas) — API de Whisper de OpenAI ──────
# El paso voz→texto usa la API de Whisper de OpenAI. La clave es POR TENANT (BYOK):
# cada cliente la pega en Configuración → IA (settings.integrations.openaiApiKey),
# cifrada en reposo. El CRM NO lee ninguna OPENAI_API_KEY del entorno. Después, Claude
# (Anthropic, también por-tenant) hace el resumen/estructura de la sesión.
