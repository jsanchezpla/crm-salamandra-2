[Unit]
Description=Envío por lotes de las campañas de mailing del CRM Salamandra
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/docker exec crm-salamandra-app-1 node scripts/enviar-mailing.js
StandardOutput=append:/var/log/crm-mailing.log
StandardError=append:/var/log/crm-mailing.log
